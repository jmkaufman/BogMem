<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>BogMem.Slices</PackageId>
    <Title>BogMem Slices</Title>
    <Description>Embedded BogMem runtime for BogDB-backed palace storage, hybrid recall, graph memory, project mining, registry routing, and MCP dispatch.</Description>
    <PackageTags>bogmem;bogdb;memory;runtime;retrieval;graph;mcp</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Bogmem.Graph/Bogmem.Graph.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Mcp/tools.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="Mcp/tools.json" LogicalName="Bogmem.Slices.Mcp.tools.json" />
    <EmbeddedResource Include="Spellcheck/data/word_count.en.json.gz" LogicalName="Bogmem.Slices.Spellcheck.data.word_count.en.json.gz" />
    <EmbeddedResource Include="Spellcheck/data/web2.txt.gz" LogicalName="Bogmem.Slices.Spellcheck.data.web2.txt.gz" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BogDB.Core" Version="1.4.0" />
    <PackageReference Include="BogDB.Extensions.FTS" Version="1.3.0" />
    <PackageReference Include="BogDB.Extensions.Vector" Version="1.3.0" />
    <PackageReference Include="ElBruno.LocalEmbeddings" Version="1.5.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Link="README.md" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" Link="LICENSE" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" Link="THIRD-PARTY-NOTICES.md" />
    <None Include="Spellcheck/data/web2.NOTICE.md" Pack="true" PackagePath="/" Link="web2.NOTICE.md" />
  </ItemGroup>
</Project>
