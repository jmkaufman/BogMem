<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Bogmem.Harness/Bogmem.Harness.csproj" />
    <ProjectReference Include="../../src/Bogmem.Slices/Bogmem.Slices.csproj" />
  </ItemGroup>
  <Target Name="RunConsoleSuite" DependsOnTargets="Build">
    <Message Text="Running Bogmem.Slices.Tests console suite via dotnet test" Importance="high" />
    <Exec Command="dotnet &quot;$(TargetPath)&quot;" WorkingDirectory="$(MSBuildProjectDirectory)/../.." IgnoreStandardErrorWarningFormat="true" />
  </Target>
</Project>
